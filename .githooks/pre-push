#!/bin/bash
# Fast local gate: lint + build + unit tests. Deliberately a SUBSET of CI
# (2026-08-07 simplification): the slow and scan-type checks — -race,
# govulncheck, Trivy, npm audit, E2E, Postgres contract tests — run in CI
# only, where they are also path-gated. This hook exists to catch the
# obvious (does not compile, lint error, unit regression, codegen drift)
# before a push spends CI minutes.
#
# Skip paths (fastest → slowest):
#   1. Tag-only push      — auto. The hook reads the refs from stdin and
#      short-circuits when every ref being pushed is under refs/tags/.
#   2. PANVEX_SKIP_PREPUSH=1  — env override for one-off bypasses.
#   3. `git push --no-verify` — git's built-in escape hatch.
set -e

# ── Tag-only push short-circuit ──────────────────────────────────────────────
# git passes one line per ref on stdin:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
any_ref=0
any_non_tag=0
while read -r local_ref _local_sha _remote_ref _remote_sha; do
    [ -z "$local_ref" ] && continue
    any_ref=1
    case "$local_ref" in
        refs/tags/*) ;;
        *) any_non_tag=1 ;;
    esac
done

if [ "$any_ref" = 1 ] && [ "$any_non_tag" = 0 ]; then
    echo "=== Pre-push: tag-only push — skipping CI mirror checks ==="
    exit 0
fi

# ── Env override ─────────────────────────────────────────────────────────────
if [ "${PANVEX_SKIP_PREPUSH:-}" = "1" ]; then
    echo "=== Pre-push: PANVEX_SKIP_PREPUSH=1 — skipping CI mirror checks ==="
    exit 0
fi

echo "=== Pre-push: Mirror install-agent.sh into server package ==="
# //go:embed cannot reference files outside the package, so we mirror
# deploy/install-agent.sh into internal/controlplane/server/ before any
# Go build/test/lint. See internal/controlplane/server/install_script.go.
go generate ./internal/controlplane/server/...

echo "=== Pre-push: Go lint ==="
# H7: golangci-lint resolves `./...` (and web/node_modules exclusion) via
# its own module-aware directory walk — it does NOT want a `go list`-
# expanded argument list of fully-qualified import paths.
~/go/bin/golangci-lint run ./...

echo "=== Pre-push: Settings codegen drift ==="
# Not covered by any CI job — this is the only guard for it.
# stdout only — stderr must stay visible or a generation failure aborts
# the hook (set -e) with no explanation.
go generate ./internal/controlplane/settings/... >/dev/null
if ! git diff --quiet -- internal/controlplane/settings/gen/schema.json docs/settings/reference.md docs/settings/example.config.toml; then
    echo "!!! Settings codegen drift; run 'make gen-settings' and commit."
    exit 1
fi

echo "=== Pre-push: Go unit tests (no -race) ==="
# -race and the loadtest suite moved to CI-only (go-test-race job): on
# memory-constrained dev hosts -race over this tree tips past 22 GB RSS.
# H7: filter web/node_modules so a local `npm ci`'d web/ doesn't drag a
# vendored npm-package Go module into the suite.
PKGS=$(go list ./... | grep -vE 'node_modules|^github.com/lost-coder/panvex/internal/loadtest$')
go test -count=1 $PKGS

echo "=== Pre-push: Frontend type-check + build ==="
cd web
npm run build

echo "=== Pre-push: Frontend lint ==="
npm run lint

echo "=== Pre-push: Frontend state tests (node --test) ==="
npm run test:state

echo "=== Pre-push: all checks passed ==="
